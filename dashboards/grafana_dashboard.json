    {
      "type": "timeseries",
      "title": "Pressure Rate of Change (hPa/hr)",
      "description": "Negative = falling pressure = approaching fronts. Alert threshold: \u22123 hPa/hr",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": -3
              },
              {
                "color": "green",
                "value": -1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"weatherdata\")\n  |> range(start: $__timeFrom, stop: $__timeTo)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and (r._field == \"pressure\" or r._field == \"quality_valid\" or r._field == \"pressure_basis\") and r.topic == \"pressure/telemetry\" and r.station == \"local-pressure\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({r with _field: \"pressure\", _value: if exists r.pressure and r.quality_valid == true and r.pressure_basis == \"legacy_sea_level_corrected\" then float(v: r.pressure) else float(v: \"NaN\")}))\n  |> keep(columns: [\"_time\", \"_field\", \"_value\", \"topic\", \"station\"])\n  |> derivative(unit: 1h, nonNegative: false)\n  |> yield(name: \"pressure_rate\")",
          "refId": "A"
        }
      ]
    }
