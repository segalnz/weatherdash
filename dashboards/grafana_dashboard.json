      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "green",
                "value": 40
              },
              {
                "color": "blue",
                "value": 80
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"weatherdata\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r._field == \"humidity\")\n  |> last()\n  |> yield(name: \"last\")",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Wind Speed",
      "gridPos": {
        "h": 4,
