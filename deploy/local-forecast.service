[Unit]
Description=Build, cache and archive six-hour local weather forecast
After=network-online.target influxdb.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/weatherdash.env
EnvironmentFile=-/etc/weatherdash-llm.env
Type=oneshot
StateDirectory=weatherdash
StateDirectoryMode=0755
User=weatherdash
Group=weatherdash
WorkingDirectory=/opt/weatherdash/venvs/barometer
ExecStart=/opt/weatherdash/.venv/bin/python /opt/weatherdash/venvs/barometer/snapshot_forecast.py
TimeoutStartSec=120
