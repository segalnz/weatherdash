[Unit]
Description=MET Norway forecast ingester for weather RAG
Documentation=https://api.met.no/
After=network-online.target influxd.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/weatherdash.env
Type=oneshot
User=weatherdash
Group=weatherdash
WorkingDirectory=/opt/weatherdash/venvs
ExecStart=/opt/weatherdash/.venv/bin/python /opt/weatherdash/venvs/metno_forecast.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
