# Supply through your shell or systemd EnvironmentFile; not loaded automatically.
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=weather
INFLUX_TOKEN=replace-with-local-token
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=replace-me
MQTT_PASSWORD=replace-me
CHIRPSTACK_APPLICATION_ID=replace-me
DEVICE_EUI=replace-with-16-hex-digits
PRESSURE_STATE_DB=/var/lib/pressure-bridge/outbox.sqlite3
PRESSURE_MQTT_USERNAME=replace-me
PRESSURE_MQTT_PASSWORD=replace-me
WEATHER_LATITUDE=replace-me
WEATHER_LONGITUDE=replace-me
WEATHER_ALTITUDE_M=243
METNO_USER_AGENT=weatherdash/1.0 (ron@segal.nz)
METNO_CACHE=/var/lib/weatherdash/metno_cache.json
FORECAST_CACHE=/var/lib/weatherdash/forecast_cache.json
FORECAST_VERIFICATION_REPORT=/var/lib/weatherdash/verification_report.json
